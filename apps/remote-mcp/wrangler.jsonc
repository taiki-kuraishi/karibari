{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "karibari-remote-mcp",
  "main": "./src/entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Declared empty on purpose: `wrangler types` then stops inferring secrets from
  // .dev.vars, so the committed worker-configuration.d.ts stays free of machine-local values.
  "secrets": { "required": [] },
  "routes": [{ "pattern": "mcp.karibari.tsar-bmb.org", "custom_domain": true }],
  "kv_namespaces": [
    {
      "binding": "DPOP_REPLAY",
      "id": "6b38ed9362e64378864a9ca2555a83a5",
    },
  ],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
}
