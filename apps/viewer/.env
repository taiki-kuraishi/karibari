# Public origin the SPA calls, not a secret: Vite inlines `VITE_`-prefixed values into the bundle.
VITE_API_ORIGIN=https://api.karibari.tsar-bmb.org
# Origin of the auth Worker: the session check and the sign-in page both live there.
VITE_AUTH_ORIGIN=https://auth.karibari.tsar-bmb.org
# Origin of the remote MCP Worker, shown on the empty home screen so a visitor can connect a client.
VITE_MCP_ORIGIN=https://mcp.karibari.tsar-bmb.org
