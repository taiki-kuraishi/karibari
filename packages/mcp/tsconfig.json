{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // fetch/Request/Response come from the DOM lib (Workers and Node both provide them).
    "lib": ["ESNext", "DOM"],
    // The RPC client's app type pulls in apps/api source files, so no rootDir:
    // the program now spans both workspaces.
    // The app type references `Cloudflare.Env`, so expose the api worker's
    // generated ambient types to this package's compiler.
    "types": ["../../apps/api/worker-configuration.d.ts"]
  },
  "include": ["src", "test"]
}
